# Application Settings
PROJECT_NAME="LinkAI Backend"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
CORS_ORIGINS=["https://localhost:3000","https://localhost:5173","https://127.0.0.1:3000","https://127.0.0.1:5173"]

# Server & HTTPS Settings
HOST="0.0.0.0"
PORT=8000
HTTPS_ENABLED=False
SSL_KEYFILE=null
SSL_CERTFILE=null

# Security & JWT
JWT_SECRET_KEY="your-jwt-secret-key-at-least-32-chars-long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Supabase Credentials
# Знайти можна у Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-anon-or-service-role-key"

# OpenAI
# Знайти можна на: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key-here"
# Доступні моделі: gpt-4o-mini (дешево), gpt-4o (точніше), gpt-4-turbo
OPENAI_MODEL="gpt-4o-mini"
# Температура: 0.0 = детермінована, 1.0 = творча. Для аналітики рекомендовано 0.3–0.5
OPENAI_TEMPERATURE=0.4
# Максимальна довжина відповіді AI (в токенах)
OPENAI_MAX_TOKENS=1024

# Google Gemini (безкоштовний tier)
# Знайти можна на: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
# Доступні моделі: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash
GEMINI_MODEL="gemini-2.5-flash"

# AI Provider — перемикач: "gemini" або "openai"
# gemini  — використовувати Gemini як основний провайдер
# openai  — використовувати OpenAI як основний (з auto-fallback на Gemini при помилці авторизації/балансу)
AI_PROVIDER="gemini"
